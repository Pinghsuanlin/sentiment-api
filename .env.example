# Copy to .env. All optional; defaults live in src/sentiment/config.py.

# distilbert | baseline
SENTIMENT_PREDICTOR=distilbert
SENTIMENT_MODEL_PATH=models/distilbert-imdb/final
SENTIMENT_BASELINE_PATH=models/baseline.joblib

# Returned in every response. Set it to a git sha or release tag.
SENTIMENT_MODEL_VERSION=dev

# Tokens. Keep equal to the value used in training.
SENTIMENT_MAX_LEN=128
SENTIMENT_MAX_TEXT_CHARS=10000
SENTIMENT_MAX_BATCH_SIZE=32
